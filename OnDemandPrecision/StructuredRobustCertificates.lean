import Mathlib

/-!
# Exact robust certificates for structured perturbation classes

The logit shifts are `δ_j = ⟨u_j, y⟩`, one row `u_j` per class, generated by a latent perturbation
`y` from a structured class. Robust preservation of the top-1 class `i` asks that `i` stays the strict
argmax for **every** admissible `y`. For two natural classes the exact (iff) certificate is computed:

* `robust_ball_iff` (low-rank, Euclidean ball `‖y‖ ≤ ρ`): robust iff `z_i - z_j > ρ ‖u_i - u_j‖` for
  all `j ≠ i`. The supremum is attained, so the certificate is exact, not only sufficient;
* `robust_simplex_iff` (sign-constrained, `y ≥ 0`, `∑ y_k ≤ ρ`): robust iff, for all `j ≠ i`,
  `z_i - z_j > 0` and `z_i - z_j > ρ (u_jk - u_ik)` for every coordinate `k`, that is
  `z_i - z_j > ρ · max(0, max_k (u_jk - u_ik))`;
* `sign_structure_separates`: a strict separation. The same rows and radius are certified under the
  sign constraint with margin `ρ/2`, while the unconstrained ball needs margin `> ρ`.
-/

namespace OnDemandPrecision

open Finset

section Ball

variable {ι E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- **Exact certificate for the Euclidean class.** -/
theorem robust_ball_iff (z : ι → ℝ) (u : ι → E) (ρ : ℝ) (hρ : 0 ≤ ρ) (i : ι) :
    (∀ y : E, ‖y‖ ≤ ρ → ∀ j, j ≠ i → z j + inner ℝ (u j) y < z i + inner ℝ (u i) y) ↔
      ∀ j, j ≠ i → ρ * ‖u i - u j‖ < z i - z j := by
  constructor
  · intro h j hj
    by_cases hv : u i - u j = 0
    · have := h 0 (by simpa using hρ) j hj
      simp only [inner_zero_right, add_zero] at this
      rw [hv, norm_zero, mul_zero]
      linarith
    · -- the worst perturbation points along `u_j - u_i`
      set v := u j - u i with hvdef
      have hvn : ‖v‖ ≠ 0 := by
        rw [hvdef, ← norm_neg, neg_sub]
        exact norm_ne_zero_iff.mpr hv
      have hvpos : 0 < ‖v‖ := lt_of_le_of_ne (norm_nonneg _) (Ne.symm hvn)
      set y := (ρ / ‖v‖) • v
      have hy : ‖y‖ ≤ ρ := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (div_nonneg hρ (norm_nonneg _)),
          div_mul_cancel₀ _ hvn]
      have key := h y hy j hj
      have hin : inner ℝ (u j) y - inner ℝ (u i) y = ρ * ‖v‖ := by
        rw [← inner_sub_left, inner_smul_right, ← hvdef, real_inner_self_eq_norm_sq]
        field_simp
      have hnorm : ‖u i - u j‖ = ‖v‖ := by rw [hvdef, ← norm_neg, neg_sub]
      rw [hnorm]
      linarith
  · intro h y hy j hj
    have hcs : inner ℝ (u j - u i) y ≤ ‖u j - u i‖ * ‖y‖ := real_inner_le_norm _ _
    have hn : ‖u j - u i‖ = ‖u i - u j‖ := by rw [← norm_neg, neg_sub]
    have hb : ‖u j - u i‖ * ‖y‖ ≤ ‖u i - u j‖ * ρ := by
      rw [hn]; exact mul_le_mul_of_nonneg_left hy (norm_nonneg _)
    have := h j hj
    rw [inner_sub_left] at hcs
    nlinarith

end Ball

section Simplex

variable {ι : Type*} {m : ℕ}

/-- **Exact certificate for the sign-constrained class** `y ≥ 0`, `∑ y_k ≤ ρ` (with `ρ > 0`). -/
theorem robust_simplex_iff (z : ι → ℝ) (U : ι → Fin m → ℝ) (ρ : ℝ) (hρ : 0 < ρ) (i : ι) :
    (∀ y : Fin m → ℝ, (∀ k, 0 ≤ y k) → ∑ k, y k ≤ ρ →
        ∀ j, j ≠ i → z j + ∑ k, U j k * y k < z i + ∑ k, U i k * y k) ↔
      ∀ j, j ≠ i → 0 < z i - z j ∧ ∀ k, ρ * (U j k - U i k) < z i - z j := by
  constructor
  · intro h j hj
    refine ⟨?_, fun k => ?_⟩
    · have := h 0 (fun _ => le_rfl) (by simpa using hρ.le) j hj
      simp only [Pi.zero_apply, mul_zero, sum_const_zero, add_zero] at this
      linarith
    · have := h (Pi.single k ρ) (fun l => by
          by_cases hl : l = k
          · subst hl; simp [hρ.le]
          · simp [hl]) (by simp) j hj
      simp only [Pi.single_apply, mul_ite, mul_zero, sum_ite_eq', mem_univ, if_true] at this
      linarith
  · intro h y hy hsum j hj
    obtain ⟨hpos, hk⟩ := h j hj
    set M := z i - z j
    -- `ρ ∑ (U_j - U_i) y ≤ M ∑ y ≤ M ρ`, strictly when `y ≠ 0`
    by_cases hy0 : ∀ k, y k = 0
    · simp only [hy0, mul_zero, sum_const_zero, add_zero]
      linarith
    · simp only [not_forall] at hy0
      obtain ⟨k0, hk0⟩ := hy0
      have hk0pos : 0 < y k0 := lt_of_le_of_ne (hy k0) (Ne.symm hk0)
      have hlt : ∑ k, ρ * (U j k - U i k) * y k < ∑ k, M * y k := by
        apply sum_lt_sum
        · intro k _
          exact mul_le_mul_of_nonneg_right (hk k).le (hy k)
        · exact ⟨k0, mem_univ _, mul_lt_mul_of_pos_right (hk k0) hk0pos⟩
      have hle : ∑ k, M * y k ≤ M * ρ := by
        rw [← mul_sum]; exact mul_le_mul_of_nonneg_left hsum hpos.le
      have hfac : ∑ k, ρ * (U j k - U i k) * y k =
          ρ * (∑ k, U j k * y k - ∑ k, U i k * y k) := by
        rw [mul_sub, mul_sum, mul_sum, ← sum_sub_distrib]
        refine sum_congr rfl fun k _ => ?_
        ring
      have hfin : ρ * (∑ k, U j k * y k - ∑ k, U i k * y k) < ρ * M := by
        rw [← hfac]; linarith
      have := lt_of_mul_lt_mul_left hfin hρ.le
      linarith

end Simplex

/-- **Strict separation by sign structure.** Two classes, one latent coordinate, rows `u_0 = 1`,
`u_1 = 0`, radius `ρ = 1` and margin `1/2`. The sign-constrained class is certified, while the
unconstrained ball with the same rows and radius is not. -/
theorem sign_structure_separates :
    let z : Fin 2 → ℝ := ![1 / 2, 0]
    let U : Fin 2 → Fin 1 → ℝ := ![![1], ![0]]
    (∀ j, j ≠ (0 : Fin 2) → 0 < z 0 - z j ∧ ∀ k, (1 : ℝ) * (U j k - U 0 k) < z 0 - z j) ∧
      ¬ (∀ j, j ≠ (0 : Fin 2) →
          (1 : ℝ) * ‖(EuclideanSpace.equiv (Fin 1) ℝ).symm (U 0) -
            (EuclideanSpace.equiv (Fin 1) ℝ).symm (U j)‖ < z 0 - z j) := by
  intro z U
  refine ⟨?_, ?_⟩
  · intro j hj
    fin_cases j
    · exact absurd rfl hj
    · refine ⟨by simp [z], fun k => ?_⟩
      fin_cases k
      simp [z, U]
      norm_num
  · intro h
    have := h 1 (by decide)
    have hn : ‖(EuclideanSpace.equiv (Fin 1) ℝ).symm (U 0) -
        (EuclideanSpace.equiv (Fin 1) ℝ).symm (U 1)‖ = 1 := by
      rw [EuclideanSpace.norm_eq]
      simp [U]
    rw [hn] at this
    simp [z] at this
    norm_num at this

end OnDemandPrecision
